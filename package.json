{
    "name": "generative-art-p5js",
    "version": "1.0.0",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "lint": "biome lint .",
        "test": "node --test \"tests/**/*.test.js\"",
        "gallery:deploy": "sketch-gallery deploy / tree.json assets libraries utils sketches",
        "gallery:build": "sketch-gallery build / tree.json assets libraries utils sketches",
        "site:copy": "node ./scripts/copy-site.js node_modules/sketch-gallery/dist",
        "umami:inject": "node ./scripts/inject-umami.js node_modules/sketch-gallery/dist",
        "version:inject": "node ./scripts/inject-version.js node_modules/sketch-gallery/dist",
        "icons:inject": "node ./scripts/inject-icons.js node_modules/sketch-gallery/dist",
        "icons": "node ./scripts/build-icons.mjs",
        "build:tree": "node ./scripts/build-tree.js sketches tree.json",
        "prebuild:previews": "npm run build:tree",
        "build:previews": "node ./scripts/build-previews.js tree.json 512x512 jpeg"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "chrome-aws-lambda": "^10.1.0",
        "puppeteer-core": "^10.4.0",
        "sketch-gallery": "github:CostardRouge/sketch-gallery#0.0.15"
    }
}
